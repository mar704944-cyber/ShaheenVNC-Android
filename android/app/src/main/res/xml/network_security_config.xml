<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release configuration: enforce HTTPS -->
    <release>
        <domain-config cleartextTrafficPermitted="false">
            <domain includeSubdomains="true">*</domain>
        </domain-config>
    </release>
    
    <!-- Debug configuration: allow localhost for development -->
    <debug>
        <!-- Development localhost exceptions -->
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="true">localhost</domain>
            <domain includeSubdomains="true">127.0.0.1</domain>
            <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android Emulator host -->
        </domain-config>
        
        <!-- Production domains must use HTTPS -->
        <domain-config cleartextTrafficPermitted="false">
            <domain includeSubdomains="true">*</domain>
        </domain-config>
    </debug>
</network-security-config>
